</head>
<body>

<!-- Side Navigation -->
<nav class="w3-sidebar w3-bar-block w3-collapse w3-white w3-animate-left w3-card" 
style="z-index:3;width:320px;" id="mySidebar">
  <a href="javascript:void(0)" class="w3-bar-item w3-button w3-border-bottom w3-large">
      digital profile : Data Entry Server.</a>
  <a href="javascript:void(0)"
   onclick="w3_close()"
    title="Close Sidemenu" 
  class="w3-bar-item w3-button 
  w3-hide-large w3-large">Close <i class="fa fa-remove"></i></a>
  <a href="javascript:void(0)" 
  class="w3-bar-item w3-button w3-dark-grey w3-button 
  w3-hover-black w3-left-align" 
