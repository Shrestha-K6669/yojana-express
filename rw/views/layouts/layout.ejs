    <!-- -->
    
<a href="javascript:void(0)" class="w3-bar-item w3-button 
    w3-dark-grey w3-button w3-hover-black w3-left-align" 
  onclick="document.getElementById('idProfileForm').style.display='block'">New Profile Entry 
    <i class="w3-padding fa fa-pencil"></i></a>

    <!-- -->

  <a id="myBtn" onclick="myFunc('Demo1')" href="javascript:void(0)"
   class="w3-bar-item w3-button"><i class="fa fa-inbox w3-margin-right"></i> Lists.
   <i class="fa fa-caret-down w3-margin-left"></i></a>
  <div id="Demo1" class="w3-hide w3-animate-left">
    <a class="w3-bar-item" href="#">link1</a>  
    <a class="w3-bar-item" href="#">link1</a>
    <a class="w3-bar-item" href="#">link1</a>   
  </div>
  <a href="#" class="w3-bar-item w3-button"><i class="fa fa-paper-plane w3-margin-right"></i>..</a>
  <a href="#" class="w3-bar-item w3-button"><i class="fa fa-hourglass-end w3-margin-right"></i>...</a>
  <a href="#" class="w3-bar-item w3-button"><i class="fa fa-trash w3-margin-right"></i>....</a>
</nav>

<!-- body here .-->
<%- if(message) { %>
<div class="message w3-input" style="margin-left:400px; text-color:red">
    <p>Relation Code is: <%= message.code %></p>
    <p> Reln desc is: <%= message.name %></p>
</div>
<% } %>
<div>
  <div id="idReln1" class="w3-modal" style="z-index:4">
  <div class="w3-modal-content w3-animate-zoom">
    <div class="w3-container w3-padding w3-red">
       <span onclick="document.getElementById('idReln1').style.display='none'"
       class="w3-button w3-red w3-right w3-xxlarge"><i class="fa fa-remove"></i></span>
      <h2>Profile entry form</h2>
    </div>
    
<form action="/addReln" method="post">
      <div class="w3-panel">
      <label>Relation Code</label>
      <input class="w3-input w3-border w3-margin-bottom" type="number" name="reln_code">
      <label>Relation Desc</label>
      <input class="w3-input w3-border w3-margin-bottom" type="text" name="name">
      <input type="submit" value="+">
      
    </div>
    </form>
  </div>
</div>
<!-- 
  house form
-->
<div id="idHouseForm" class="w3-modal" style="z-index:4">
  <div class="w3-modal-content w3-animate-zoom">
    <div class="w3-container w3-padding w3-red">
       <span onclick="document.getElementById('idHouseForm').style.display='none'"
       class="w3-button w3-red w3-right w3-xxlarge"><i class="fa fa-remove"></i></span>
      <h2>House Num Entry form</h2>
    </div>
    
<form action="/addHouse" method="post">
      <div class="w3-panel">
      <label>Ward No:</label>
      <input class="w3-input w3-border w3-margin-bottom" type="number" name="ward_no">
      <label>House No:</label>
      <input class="w3-input w3-border w3-margin-bottom" type="number" name="house_no">
      <label>House Desc</label>
      <input class="w3-input w3-border w3-margin-bottom" type="text" name="house_desc">
      <input type="submit" value="+">
      
    </div>
    </form>
  </div>
</div>
<!-- -->
<div id="idToleForm" class="w3-modal" style="z-index:4">
  <div class="w3-modal-content w3-animate-zoom">
    <div class="w3-container w3-padding w3-red">
       <span onclick="document.getElementById('idToleForm').style.display='none'"
       class="w3-button w3-red w3-right w3-xxlarge"><i class="fa fa-remove"></i></span>
      <h2>House Num Entry form</h2>
    </div>
    
<form action="/addTole" method="post">
      <div class="w3-panel">
      <label>Ward No:</label>
      <input class="w3-input w3-border w3-margin-bottom" type="number" name="ward_no">
      <label>Tole Name:</label>
      <input class="w3-input w3-border w3-margin-bottom" type="text" name="tole_name">
      <label>Tole Desc</label>
      <input class="w3-input w3-border w3-margin-bottom" type="text" name="tole_desc">
      <input type="submit" value="+">
      
    </div>
    </form>
  </div>
</div>
<!-- -->

<div id="idProfileForm" class="w3-modal" style="z-index:4">
  <div class="w3-modal-content w3-animate-zoom">
    <div class="w3-container w3-padding w3-red">
       <span onclick="document.getElementById('idProfileForm').style.display='none'"
       class="w3-button w3-red w3-right w3-xxlarge"><i class="fa fa-remove"></i></span>
      <h2>profile Entry form</h2>
    </div>
  <!-- 
<form id="profileForm" action="/addProfile" method="post"> -->
<form id="profileForm"></form>
      <div class="w3-panel">
        <label>Relation:</label>
      <select class="w3-input w3-border w3-margin-bottom" name="reln" id="reln">
        <option>----</option>
        <%- if(relation){ %>
  <% relation.forEach(function(){ %>
  <option class="w3-input w3-border w3-margin-bottom" value="<%= _id%>"><%-reln_code%>||<%-name%></option>
  <% )} %>
  <%- } %>
</select>
<br>
      <label>Tole Name:</label>
      <select class="w3-input w3-border w3-margin-bottom" name="tole" id="profile_tole">
        <option>----</option>
        <%- if(tole) { %>
  <% tole.forEach(function(el) { %>
  <option class="w3-input w3-border w3-margin-bottom" value="<%= el._id  %>"><%= el.tole_name %></option>
  <% )} %>
  <% } %>
</select>
<br>
  <label>House num:</label>
      <select class="w3-input w3-border w3-margin-bottom" name="house_num" id="profile_housenum">
        <option>----</option>
        <%- if(house_num){ %>
  <% house_num.forEach(function(el) %>
  <option class="w3-input w3-border w3-margin-bottom" value="<%= el._id %>"><%= el.house_no %></option>
  <% )} %>
  <% } %>
</select>
      <br>
      <label>Name English</label>
      <input class="w3-input w3-border w3-margin-bottom" type="text" name="name_eng" id="name_eng">
      <label>Name Nepali</label>
      <input class="w3-input w3-border w3-margin-bottom" type="text" name="name_nep" id="name_nep">
       <label> Gender:</label>
      <select class="w3-input w3-border w3-margin-bottom" name="gender" id="gender" id="gender">
        <option>----</option>
       <option value="Male">Male</option>
       <option value="Female">Female</option>
       <option value="Others">Others</option>
  </select>
  <br>
  <label>Date of Birth</label>
      <input class="w3-input w3-border w3-margin-bottom" type="text" name="dob" id="dob">
      <label>Citizenship Number:</label>
      <input class="w3-input w3-border w3-margin-bottom" type="text" name="ctz_no" id="ctz_no">
     <input type="submit" value="+"> 
      
    </div>
    <!--
    </form> -->
  </div>
</div>
