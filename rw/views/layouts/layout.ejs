function submitProfile(){
    event.preventDefault()       
  const data={
  reln:document.getElementById('reln').value,
  house_num:document.getElementById('profile_housenum').value,
  tole:document.getElementById('profile_tole').value,
  name_eng:document.getElementById('name_eng').value,
  name_nep:document.getElementById('name_nep').value,
  gender:document.getElementById('gender').value,
  dob:document.getElementById('dob').value,
  ctz_no:document.getElementById('ctz_no').value
  }
  axios.post('/addProfile', data)
  .then(function (response) {
    console.log(response);
  })
  .catch(function (error) {
    console.log(error);
  });
}

  
