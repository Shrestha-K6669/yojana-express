    <i class="w3-padding fa fa-pencil"></i></a>
    <!-- -->
    <a href="javascript:void(0)" class="w3-bar-item w3-button w3-dark-grey 
    w3-button w3-hover-black w3-left-align" 
  onclick="document.getElementById('idHouseForm').style.display='block'">New House Entry 
    <i class="w3-padding fa fa-pencil"></i></a>
    <!-- -->
    <a href="javascript:void(0)" class="w3-bar-item w3-button 
    w3-dark-grey w3-button w3-hover-black w3-left-align" 
  onclick="document.getElementById('idToleForm').style.display='block'">New Tole Entry 
