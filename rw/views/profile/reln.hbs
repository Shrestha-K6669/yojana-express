
{{#if relation}}
<div class="w3-input">
    <p> Inputted Id is: {{message._id}}</p>
    <p>Relation Code is: {{message.code}}</p>
    <p> Reln desc is: {{message.name}}</p>
</div>
{{/if}}
<form enctype="multipart/form-data" action="/addReln" method="post">
