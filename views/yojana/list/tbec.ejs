
    
     
     
<div class="col-6 col-ss-9">
    <div class="r1"> <div class="nametb"><%= data.name %> </div> ,
     <%= data.office_address%>,
    <%= data.tole %> पूर्वी सिमानाः <%= data.boundary_east%>,
     पश्चिम सिमानाः <%= data.boundary_west %>
    उत्तरी सिमानाः <%= data.boundary_north %>, 
    र दक्षिण सिमानाः <%= data.boundary_west %> भएको,
    प्यान नं <%= data.pan_num %>, 
    बैक खाताः <%= data.account_num%> विवरण भएको खुम्बु पासाङल्हामु गाउँपालिका क्षेत्र भित्रको
    लाभग्राही सँस्थाको विवरण भर्नुहोस्ः
    </div>
    <div class="ch">
      <Button><a href="/addTBRec/<%= data._id %>">Back to ToleBikas Dashboard..</a></Button>
      </div>
    tbid: <%= data._id %>
    <div class="member">
        <p style="color: red;"> विवरण भरिसकिएका लाभग्राही सँस्थाको 
        अनुगमन समितिको सदस्य विवरण</p>
            <table id="members">
            <tr>
                <th class="h">S.N</th>
                <th class="h">Name</th>
                <th class="h">Designation</th>
                <th class="h">Citizenship number</th>
                <th class="h">Edit</th>
                <th class="h"> Delete</th>
                </tr>
                  <% var i=0;
              members.forEach(function (e) { i++;  %>
                <tr>
                <td class="td1"><span class="t"><%= i %></span></td>
                <td class="td2"> <span class="t"><%= e.name %></span></td>
                <td class="td3"><span class="t"><%= e.designation %></span></td>
                <td class="td4"><span class="t"><%= e.ctz %></span></td>
                <td class="td5"><span class="t">
                    <Button onclick="window.location.href='/tbeceditform/<%= e._id%>';">Edit</Button></span></td>
                <td class="td6"> <span class="t">
                    <form action="/delTBEC" method="post">
                    <input type="hidden" name="id" value="<%= e._id %>">
                    <input type="hidden" name="tolebks_id" value="<%= e.tolebks_id %>">
                    <button type="submit"> Delete</button>
                    </form>
                   </td>
                </tr>
              <% }) %>
        </table>
    </div>
    <div class="ch">
        <button onclick="window.location.href='/addTBECmemberForm/<%= data._id %>';">Add New</button>
      </div>
    </div>
    
    <style>
        #members {
  font-family: Arial, Helvetica, sans-serif;
  border-collapse: collapse;
  width: 100%;
}

#members td, #members th {
  border: 1px solid #ddd;
  padding: 8px;
}

#members tr:nth-child(even){background-color: #f2f2f2;}

#members tr:hover {background-color: #ddd;}

#members th {
  padding-top: 12px;
  padding-bottom: 12px;
  text-align: left;
  background-color: #04AA6D;
  color: white;
}    
    </style>

    