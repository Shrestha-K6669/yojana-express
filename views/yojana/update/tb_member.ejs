<form action="/updateTBM" method="post">
    <div class="col">
        <div class="row">
            <input type="hidden" name="id" value="<%= data._id %>">
            <input type="hidden" name="tolebikas_id" value="<%= data.tolebikas_id%>">
        </div>
        <div class="row">
            <div class="left"> <label for="name"> Name(नामः)</label> </div>
            <div class="forminput">
                <input type="text" class="input" name="name" id="name" value="<%= data.name %>">
            </div>
        </div>
        <div class="row">
            <div class="left"> <label for="designation">Designation(पदः)</label></div>
            <div class="forminput"><input type="text" class="input" name="designation" id="designation" value="<%= data.designation%>"></div>
        </div>
        <div class="row"><div class="left"><label for="address">Address(ठेगानाः)</label></div> 
    <div class="forminput"><input type="text" class="input" name="address" id="address" value="<%= data.address%>"></div>
    </div>
    <div class="row">
        <div class="left"><label for="ctz">Citizenship No: (नागरिकता नं)</label></div>
        <div class="forminput"><input type="text" class="input" name="ctz" id="ctz" value="<%= data.ctz%>"></div>
    </div>
    <div class="row">
    <div class="left"><label for="contact">Contact(सम्पर्क नं)</label></div>
    <div class="forminput"><input type="text" class="input" name="contact" id="contact" value="<%= data.contact%>"></div>
</div>
<div class="row">
    <div class="left"><label for="sequence">Sequence</label></div>
    <div class="forminput"><input type="number" class="input" name="seq" value="<%= data.seq %>" id="seq"></div>
</div>
<div class="forminput"><button class="input" type="submit">+</button></div>
    </div>
</form>
<style>
    .col{
        display: flex;flex-direction: column;border-style: solid;border-color: lightblue;width:75%;
    }
    .row{
        display: flex;flex-direction: row;padding: 5px;
    }
    .left{
        width:25%;margin-left: 10px; margin-right: 8px;
    }
    .forminput{
        width:45%;
    }
    .input{
        width:85%;height: 40px;padding:4px;
    }
</style>