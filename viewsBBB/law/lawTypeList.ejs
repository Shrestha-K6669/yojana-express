<div class="house_list w3-main" style="margin-left:320px">
    <p>Relation List</p>
    <table class="w3-container">
  <tr>
    <th class="head">S.N</th>
    <th class="head">Relation Code</th>
    <th class="head">Relation Name</th>
     <th>Deletion</th>
  </tr>
  <% var i=0;
  data.forEach(function (e) { i++;  %>
  <tr>
    <td class="sn"><%= i %></td>
    <td class="wn"><%= e.reln_code %></td>
    <td class="hn"><%= e.name %></td>
    <td><a href="/deleteReln/<%= e._id %>">Delete</a></td>
  </tr>
  <% })%>
</table>
</div>
<style>
    .house_list{
        width:70%;
        margin-left:20%;
    }
    table {
  width:100%;
}
table, th, td {
  border: 1px solid black;
  border-collapse: collapse;
}
th, td {
  padding: 15px;
  text-align: left;
}
</style>