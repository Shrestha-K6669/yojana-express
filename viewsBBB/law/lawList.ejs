<div class="kanun_list w3-main" style="margin-left:320px">
    <table class="w3-container">
  <tr>
    <th class="head">S.N</th>
    <th class="head">File_Name</th>
    <th class="head">type</th>
    <th class="head">File_Pdf</th>
    <th class="head"> Pdf File View</th>
    <th class="head">File_Excel</th>
    <th class="head"> Edit</th>
    <th>Delete</th>
  </tr>
  <% var i=0;
  data.forEach(function (e) { i++;  %>
  <tr>
    <td class="sn"><%= i %></td>
    <td class="wn"><%= e.kanun %></td>
    <td class="hn"><%= e.kanun_type %></td>
    <td class="hn"><a href="/uploads/<%= e.k_file_pdf %>" download> <%= e.kanun %></a></td>
    <td class="hn"> <form id="page" action="/viewFile" method="post">
      <input type="hidden" id="f" name="f" value="<%= e.k_file_pdf %>">
      <button type="submit"><%= e.k_file_pdf %> --View </button></form>
      </td>
    <td class="hd"><a href="/uploads/<%= e.k_file_word %>" download> <%= e.kanun %></a></td>
    <td><a href="/editKanun/<%= e._id %>">Edit</a></td>
    <td><a href="/deleteKanun/<%= e._id %>">Delete</a></td>
  </tr>
  <% })%>
</table>
</div>
<style>
    .kanun_list{
        width:70%;
        margin-left:20%;
    }
    table {
  width:100%;
}
table, th, td {
  border: 1px solid black;
  border-collapse: collapse;
}
th, td {
  padding: 15px;
  text-align: left;
}
</style>

<style>
.pagination {
  display: inline-block;
}

.pagination a {
  color: black;
  float: left;
  padding: 8px 16px;
  text-decoration: none;
}

.pagination a.active {
  background-color: #4CAF50;
  color: white;
}

.pagination a:hover:not(.active) {background-color: #ddd;}
.page-row{
  display: flex;
  flex-direction: row;
}

</style>
<div class="pagination" style="margin-left:40%">
  <div class="page-row">
    <a href="#">&laquo;</a>
    <form id="page" action="/lawsPage" method="post">
      <input type="hidden" id="page" name="page" value="1"><button type="submit">1</button></form>
    <form id="page" action="/lawsPage" method="post">
    <input type="hidden" id="page" name="page" value="2"><button type="submit">2</button></form>
    <form id="page" action="/lawsPage" method="post">
      <input type="hidden" id="page" name="page" value="3"><button type="submit">3</button></form>
      <form id="page" action="/lawsPage" method="post">
        <input type="hidden" id="page" name="page" value="4"><button type="submit">4</button></form>
        <form id="page" action="/lawsPage" method="post">
          <input type="hidden" id="page" name="page" value="5"><button type="submit">5</button></form>  
          <form id="page" action="/lawsPage" method="post">
            <input type="hidden" id="page" name="page" value="6"><button type="submit">6</button></form>
            <a href="#">&raquo;</a>
  </div>
  
</div>

